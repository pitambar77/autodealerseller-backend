{
  "name": "autodealer-api",
  "version": "1.0.0",
  "description": "AutoDealer marketplace REST API (Node.js, Express, MongoDB/Mongoose)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:fresh": "node src/scripts/seed.js --drop",
    "create-admin": "node src/scripts/createAdmin.js",
    "close-accounts": "node src/scripts/closeAccounts.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check:services": "node src/scripts/checkServices.js",
    "check:offers": "node src/scripts/checkOffers.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "redis": "^4.7.0"
  }
}
